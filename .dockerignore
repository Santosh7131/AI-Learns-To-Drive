# keep the build context small & reproducible
**/__pycache__/
**/*.pyc
backend/venv/
backend/.venv/
# Exclude all checkpoints from the build context...
backend/checkpoints/*.pt
backend/checkpoints/*.json
# ...except the pre-trained default-track model, so the cloud demo boots
# already-trained (auto-resumes on startup) instead of flailing on CPU.
!backend/checkpoints/autosave-default.pt
!backend/checkpoints/best-default.pt
!backend/checkpoints/history.json
frontend/node_modules/
frontend/dist/
.git/
*.log
.DS_Store
